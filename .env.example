APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated allowed browser origins.
# Development default works as-is; production example: https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173
# Optional: only required for scripts/init_database.py and scripts/run_pipeline.py.
# The API runtime does not connect to PostgreSQL.
DATABASE_URL=postgresql+psycopg://supplysphere:supplysphere@localhost:5432/supplysphere
RAW_DATA_DIR=data/raw
STAGING_DATA_DIR=data/staging
PROCESSED_DATA_DIR=data/processed
MODEL_DIR=ml/models
# Render build-time runtime artifact (external tar.gz; not in Git).
# SUPPLYSPHERE_RUNTIME_ARTIFACT_URL=https://github.com/junaid1488/SupplySphere/releases/download/deploy-runtime-v1/supplysphere-runtime.tar.gz
# SUPPLYSPHERE_RUNTIME_ARTIFACT_SHA256=f3c366ad21e290e1c0568811c23f70fdc4976e6df9cb77efd1a5e1873a78e36f
